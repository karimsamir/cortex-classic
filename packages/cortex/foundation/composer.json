{
    "name": "cortex/foundation",
    "description": "Cortex Foundation is a powerful framework for building modular, multi-tenant Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3.0",
        "laravel/framework": "^11.0.0",
        "illuminate/support": "^11.0.0",
        "rinvex/laravel-support": "*",
        "rinvex/laravel-composer": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0.0",
        "orchestra/testbench": "^9.0.0"
    },
    "autoload": {
        "psr-4": {
            "Cortex\\Foundation\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cortex\\Foundation\\Providers\\FoundationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
