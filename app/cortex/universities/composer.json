{
  "name": "cortex/universities",
  "description": "Cortex Universities is a new module for rinvex/cortex applications.",
  "type": "cortex-module",
  "keywords": [
    "rinvex",
    "cortex",
    "flexible",
    "framework",
    "laravel",
    "themes",
    "solution",
    "extension",
    "enterprise",
    "application",
    "multi-lingual",
    "multi-tenant",
    "bootstrap",
    "module"
  ],
  "license": "MIT",
  "homepage": "https://rinvex.com",
  "support": {
    "email": "help@rinvex.com",
    "issues": "https://github.com/rinvex/cortex-universities/issues",
    "source": "https://github.com/rinvex/cortex-universities",
    "docs": "https://github.com/rinvex/cortex-universities/README.md"
  },
  "authors": [
    {
      "name": "Rinvex LLC",
      "homepage": "https://rinvex.com",
      "email": "help@rinvex.com"
    },
    {
      "name": "Abdelrahman Omran",
      "homepage": "https://omranic.com",
      "email": "me@omranic.com",
      "role": "Project Lead"
    },
    {
      "name": "The Generous Laravel Community",
      "homepage": "https://github.com/rinvex/cortex-universities/contributors"
    }
  ],
  "require": {
    "php": "^8.3.0",
    "cortex/foundation": "dev-master",
    "diglactic/laravel-breadcrumbs": "^10.0.0",
    "illuminate/auth": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "illuminate/console": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "illuminate/http": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "illuminate/routing": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "illuminate/support": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "laravelcollective/html": "dev-master",
    "league/fractal": "^0.20.0",
    "proengsoft/laravel-jsvalidation": "^4.10.2",
    "rinvex/laravel-composer": "dev-master",
    "rinvex/laravel-menus": "dev-master",
    "rinvex/laravel-support": "dev-master",
    "rinvex/tmp-josephsilber-bouncer": "dev-master",
    "spatie/laravel-activitylog": "^4.7.0",
    "yajra/laravel-datatables-fractal": "^12.0.1",
    "yajra/laravel-datatables-buttons": "^12.3.1",
    "yajra/laravel-datatables-html": "^12.7.0",
    "yajra/laravel-datatables-oracle": "^12.6.3"
  },
  "require-dev": {
    "codedungeon/phpunit-result-printer": "^0.32.0",
    "phpunit/phpunit": "^10.1.0"
  },
  "autoload": {
    "psr-4": {
      "Cortex\\Universities\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cortex\\Universities\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cortex\\Universities\\Providers\\UniversitiesServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
