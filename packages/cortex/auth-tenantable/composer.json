{
    "name": "cortex/auth-tenantable",
    "description": "Cortex Auth Tenantable is a tenantable authentication system for Laravel Cortex.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://rinvex.com",
    "require": {
        "php": "^8.3.0",
        "illuminate/support": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/database": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/console": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "cortex/auth": "*",
        "cortex/foundation": "*",
        "cortex/tenants": "*",
        "symfony/console": "^7.2.0"
    },
    "autoload": {
        "psr-4": {
            "Cortex\\Auth\\Tenantable\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cortex\\Auth\\Tenantable\\Providers\\AuthTenantableServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
