{
    "name": "cortex/tenants",
    "description": "Cortex Tenants is a frontend layer for the contextually intelligent polymorphic Laravel package, for single db multi-tenancy. You can completely isolate tenants data with ease using the same database, with full power and control over what data to be centrally shared, and what to be tenant related and therefore isolated from others.",
    "type": "cortex-module",
    "keywords": [
        "model",
        "tenant",
        "laravel",
        "eloquent",
        "tenantable",
        "translatable",
        "polymorphic",
        "sluggable",
        "tenancy",
        "rinvex",
        "multi"
    ],
    "license": "MIT",
    "homepage": "https://rinvex.com",
    "support": {
        "email": "help@rinvex.com",
        "issues": "https://github.com/rinvex/cortex-tenants/issues",
        "source": "https://github.com/rinvex/cortex-tenants",
        "docs": "https://github.com/rinvex/cortex-tenants/README.md"
    },
    "authors": [
        {
            "name": "Rinvex LLC",
            "homepage": "https://rinvex.com",
            "email": "help@rinvex.com"
        },
        {
            "name": "Abdelrahman Omran",
            "homepage": "https://omranic.com",
            "email": "me@omranic.com",
            "role": "Project Lead"
        },
        {
            "name": "The Generous Laravel Community",
            "homepage": "https://github.com/rinvex/cortex-tenants/contributors"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "illuminate/broadcasting": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/console": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/contracts": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/database": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/http": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/queue": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/routing": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/support": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "cortex/auth": "dev-master",
        "cortex/foundation": "dev-master",
        "diglactic/laravel-breadcrumbs": "^10.0.0",
        "laravelcollective/html": "dev-master",
        "league/fractal": "^0.20.0",
        "proengsoft/laravel-jsvalidation": "^4.8.0",
        "propaganistas/laravel-phone": "^5.0.0",
        "rinvex/laravel-composer": "dev-master",
        "rinvex/countries": "dev-master",
        "rinvex/languages": "dev-master",
        "rinvex/laravel-tags": "dev-master",
        "rinvex/laravel-menus": "dev-master",
        "rinvex/laravel-support": "dev-master",
        "rinvex/laravel-tenants": "dev-master",
        "spatie/laravel-activitylog": "^4.7.0",
        "spatie/laravel-medialibrary": "^11.17.10",
        "spatie/laravel-schemaless-attributes": "^2.4.0",
        "yajra/laravel-datatables-buttons": "^12.3.1",
        "yajra/laravel-datatables-fractal": "^12.0.1",
        "yajra/laravel-datatables-html": "^12.7.0",
        "yajra/laravel-datatables-oracle": "^12.6.3",
        "symfony/console": "^7.4.4"
    },
    "require-dev": {
        "codedungeon/phpunit-result-printer": "^0.32.0",
        "phpunit/phpunit": "^10.1.0"
    },
    "autoload": {
        "psr-4": {
            "Cortex\\Tenants\\": "src/",
            "Cortex\\Tenants\\Database\\Factories\\": "database/factories/",
            "Cortex\\Tenants\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cortex\\Tenants\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cortex\\Tenants\\Providers\\TenantsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
