{
    "name": "cortex/tags",
    "description": "Cortex Tags is a taggable polymorphic Laravel package.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://rinvex.com",
    "require": {
        "php": "^8.3.0",
        "illuminate/support": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/database": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/console": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "cortex/foundation": "*",
        "rinvex/laravel-tags": "*",
        "symfony/console": "^7.2.0"
    },
    "autoload": {
        "psr-4": {
            "Cortex\\Tags\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cortex\\Tags\\Providers\\TagsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
