{
    "name": "cortex/pages",
    "description": "Cortex Pages is a pages management system for Laravel Cortex.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://rinvex.com",
    "require": {
        "php": "^8.3.0",
        "illuminate/support": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/database": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/console": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "cortex/foundation": "*",
        "rinvex/laravel-pages": "*",
        "symfony/console": "^7.2.0"
    },
    "autoload": {
        "psr-4": {
            "Cortex\\Pages\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cortex\\Pages\\Providers\\PagesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
