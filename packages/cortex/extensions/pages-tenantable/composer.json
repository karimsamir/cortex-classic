{
    "name": "cortex/pages-tenantable",
    "description": "Cortex Pages is a frontend layer for an integral part of your Laravel content management system (CMS), it affords an easy, yet powerful way to create and manage pages with full control over their URLs, active status, titles, content, and other attributes.",
    "type": "cortex-extension",
    "keywords": [
        "ajax",
        "async",
        "laravel",
        "rinvex",
        "pages",
        "cache",
        "page",
        "cms"
    ],
    "license": "MIT",
    "homepage": "https://rinvex.com",
    "support": {
        "email": "help@rinvex.com",
        "issues": "https://github.com/rinvex/cortex-pages/issues",
        "source": "https://github.com/rinvex/cortex-pages",
        "docs": "https://github.com/rinvex/cortex-pages/README.md"
    },
    "authors": [
        {
            "name": "Rinvex LLC",
            "homepage": "https://rinvex.com",
            "email": "help@rinvex.com"
        },
        {
            "name": "Abdelrahman Omran",
            "homepage": "https://omranic.com",
            "email": "me@omranic.com",
            "role": "Project Lead"
        },
        {
            "name": "The Generous Laravel Community",
            "homepage": "https://github.com/rinvex/cortex-pages/contributors"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "illuminate/http": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/routing": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/support": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "cortex/foundation": "dev-master",
        "cortex/pages": "dev-master",
        "cortex/tenants": "dev-master",
        "diglactic/laravel-breadcrumbs": "^10.0.0",
        "laravelcollective/html": "dev-master",
        "proengsoft/laravel-jsvalidation": "^4.8.0",
        "rinvex/laravel-composer": "dev-master",
        "rinvex/laravel-menus": "dev-master",
        "rinvex/laravel-support": "dev-master",
        "rinvex/laravel-tenants": "dev-master",
        "yajra/laravel-datatables-buttons": "^12.3.1",
        "yajra/laravel-datatables-fractal": "^12.0.1",
        "yajra/laravel-datatables-html": "^12.7.0",
        "yajra/laravel-datatables-oracle": "^12.6.3"
    },
    "require-dev": {
        "codedungeon/phpunit-result-printer": "^0.32.0",
        "phpunit/phpunit": "^10.1.0"
    },
    "autoload": {
        "psr-4": {
            "Cortex\\Pages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cortex\\Pages\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cortex\\Pages\\Providers\\PagesTenantableServiceProvider"
            ]
        },
        "cortex": {
            "extends": "cortex/pages"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
