{
    "name": "cortex/foundation",
    "description": "Cortex Foundation is a lightweight and simple foundation system for Laravel Cortex, to start building your next big idea.",
    "type": "library",
    "keywords": [
        "rinvex",
        "cortex",
        "flexible",
        "framework",
        "laravel",
        "themes",
        "solution",
        "extension",
        "enterprise",
        "application",
        "multi-lingual",
        "multi-tenant",
        "bootstrap",
        "module",
        "foundation",
        "core",
        "base"
    ],
    "license": "MIT",
    "homepage": "https://rinvex.com",
    "support": {
        "email": "help@rinvex.com",
        "issues": "https://github.com/rinvex/cortex-foundation/issues",
        "source": "https://github.com/rinvex/cortex-foundation",
        "docs": "https://github.com/rinvex/cortex-foundation/README.md"
    },
    "authors": [
        {
            "name": "Rinvex LLC",
            "homepage": "https://rinvex.com",
            "email": "help@rinvex.com"
        },
        {
            "name": "Abdelrahman Omran",
            "homepage": "https://omranic.com",
            "email": "me@omranic.com",
            "role": "Project Lead"
        },
        {
            "name": "The Generous Laravel Community",
            "homepage": "https://github.com/rinvex/cortex-foundation/contributors"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "illuminate/console": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/http": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/routing": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/support": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/view": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "mcamara/laravel-localization": "*",
        "mariuzzo/laravel-js-localization": "*",
        "propaganistas/laravel-phone": "*",
        "pragmarx/google2fa": "*",
        "spatie/laravel-activitylog": "*",
        "diglactic/laravel-breadcrumbs": "*",
        "symfony/finder": "^7.2.0",
        "symfony/http-foundation": "^7.2.0",
        "symfony/http-kernel": "^7.2.0",
        "symfony/mime": "^7.2.0",
        "symfony/process": "^7.2.0",
        "symfony/routing": "^7.2.0",
        "symfony/translation": "^7.2.0",
        "symfony/var-dumper": "^7.2.0",
        "vinkla/hashids": "^13.0.0",
        "yajra/laravel-datatables-buttons": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "yajra/laravel-datatables-fractal": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "yajra/laravel-datatables-html": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "yajra/laravel-datatables-oracle": "^10.4.0 || ^11.0.0 || ^12.0.0"
    },
    "require-dev": {
        "codedungeon/phpunit-result-printer": "^0.32.0",
        "phpunit/phpunit": "^10.1.0"
    },
    "autoload": {
        "psr-4": {
            "Cortex\\Foundation\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Cortex\\Foundation\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cortex\\Foundation\\Providers\\FoundationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
