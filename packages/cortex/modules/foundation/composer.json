{
    "name": "cortex/foundation",
    "description": "The core foundation of Rinvex Cortex modular application architecture.",
    "type": "cortex-module",
    "keywords": [
        "rinvex",
        "cortex",
        "module",
        "laravel",
        "foundation",
        "architecture",
        "modular",
        "kernel",
        "heart",
        "core"
    ],
    "license": "MIT",
    "homepage": "https://rinvex.com",
    "support": {
        "email": "help@rinvex.com",
        "issues": "https://github.com/rinvex/cortex-foundation/issues",
        "source": "https://github.com/rinvex/cortex-foundation",
        "docs": "https://github.com/rinvex/cortex-foundation/README.md"
    },
    "authors": [
        {
            "name": "Rinvex LLC",
            "homepage": "https://rinvex.com",
            "email": "help@rinvex.com"
        },
        {
            "name": "Abdelrahman Omran",
            "homepage": "https://omranic.com",
            "email": "me@omranic.com",
            "role": "Project Lead"
        },
        {
            "name": "The Generous Laravel Community",
            "homepage": "https://github.com/rinvex/cortex-foundation/contributors"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "illuminate/broadcasting": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/cache": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/console": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/container": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/contracts": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/database": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/events": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/filesystem": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/http": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/log": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/pagination": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/pipeline": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/queue": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/routing": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/session": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/support": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/translation": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/validation": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "illuminate/view": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "barryvdh/laravel-snappy": "^1.0.0",
        "diglactic/laravel-breadcrumbs": "^10.0.0",
        "h4cc/wkhtmltoimage-amd64": "^0.12.0",
        "h4cc/wkhtmltopdf-amd64": "^0.12.0",
        "geoip2/geoip2": "^2.11.0",
        "laravel/framework": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "laravelcollective/html": "dev-master",
        "league/fractal": "^0.20.0",
        "maatwebsite/excel": "^3.1.0",
        "mcamara/laravel-localization": "^2.3.0",
        "mariuzzo/laravel-js-localization": "dev-master",
        "appstract/laravel-opcache": "^4.0.0",
        "proengsoft/laravel-jsvalidation": "^4.10.2",
        "rinvex/laravel-composer": "dev-master",
        "rinvex/laravel-menus": "dev-master",
        "rinvex/laravel-pages": "dev-master",
        "rinvex/laravel-support": "dev-master",
        "rinvex/laravel-tags": "dev-master",
        "rinvex/tmp-edvinaskrucas-notification": "dev-master",
        "rinvex/tmp-lord-laroute": "dev-master",
        "rinvex/tmp-josephsilber-bouncer": "dev-master",
        "spatie/laravel-activitylog": "^4.7.0",
        "spatie/laravel-collection-macros": "^8.0.2",
        "spatie/laravel-medialibrary": "^11.17.10",
        "torann/geoip": "^3.0.0",
        "vinkla/hashids": "^13.0.0",
        "symfony/finder": "^7.4.5",
        "symfony/http-kernel": "^7.4.5",
        "symfony/console": "^7.4.4",
        "yajra/laravel-datatables-buttons": "^12.3.1",
        "yajra/laravel-datatables-fractal": "^12.0.1",
        "yajra/laravel-datatables-html": "^12.7.0",
        "yajra/laravel-datatables-oracle": "^12.6.3"
    },
    "require-dev": {
        "codedungeon/phpunit-result-printer": "^0.32.0",
        "phpunit/phpunit": "^10.1.0"
    },
    "autoload": {
        "files": [
            "src/Support/helpers.php"
        ],
        "psr-4": {
            "Cortex\\Foundation\\": "src/",
            "Cortex\\Foundation\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cortex\\Foundation\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cortex\\Foundation\\Providers\\BootServiceProvider",
                "Cortex\\Foundation\\Providers\\DiscoveryServiceProvider",
                "Cortex\\Foundation\\Providers\\FoundationServiceProvider",
                "Cortex\\Foundation\\Providers\\ConsoleSupportServiceProvider",
                "Cortex\\Foundation\\Overrides\\Lord\\Laroute\\LarouteServiceProvider",
                "Cortex\\Foundation\\Overrides\\Appstract\\Opcache\\OpcacheServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
